{
  "globs": ["**/*.md", "!node_modules", "!**/node_modules/**", "!plugins/base/skills/**"],
  "config": {
    "default": true,
    "MD013": { "line_length": 120, "code_blocks": false, "tables": false },
    "MD033": { "allowed_elements": ["br", "details", "summary"] },
    "MD041": false,
    "MD046": false,
    "MD047": true,
  },
}
